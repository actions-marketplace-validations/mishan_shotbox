{
  "name": "shotbox",
  "version": "0.10.0",
  "description": "Playwright helpers for reproducible browser screenshots and recordings: a static server, a sealed browser environment, frame-by-frame recordings, captions, GIFs, page errors and checks. The shotbox command itself is on PyPI.",
  "keywords": ["screenshots", "playwright", "visual-regression", "testing", "accessibility", "a11y", "wcag", "recording", "gif", "reproducible"],
  "type": "module",
  "exports": {
    ".": "./node/index.mjs",
    "./a11y": "./node/a11y.mjs",
    "./serve": "./node/serve.mjs",
    "./check": "./node/check.mjs",
    "./dress": "./node/dress.mjs",
    "./errors": "./node/errors.mjs",
    "./film": "./node/film.mjs",
    "./frames": "./node/frames.mjs",
    "./gif": "./node/gif.mjs",
    "./launch": "./node/launch.mjs",
    "./sealed": "./node/sealed.mjs"
  },
  "bin": { "shotbox-serve": "node/serve.mjs" },
  "files": ["node"],
  "repository": { "type": "git", "url": "git+https://github.com/mishan/shotbox.git" },
  "homepage": "https://github.com/mishan/shotbox/blob/main/docs/node.md",
  "bugs": "https://github.com/mishan/shotbox/issues",
  "license": "MIT",
  "author": "Misha Nasledov <misha@nasledov.com>",
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "types": "tsc",
    "prepublishOnly": "tsc"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  }
}
