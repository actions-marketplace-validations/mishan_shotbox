cd ~ || exit
PS1='\[\e[1;32m\]$\[\e[0m\] '
export GIT_PAGER=cat GIT_AUTHOR_NAME=demo GIT_AUTHOR_EMAIL=demo@example.com \
  GIT_COMMITTER_NAME=demo GIT_COMMITTER_EMAIL=demo@example.com
git init -q && git add sketchpad.py && git commit -qm sketchpad
echo "*.py diff=python" > .git/info/attributes
# Each app starts in the background, quietly; sketchpad again stops the one before.
start() { (python3 "$1.py" >/dev/null 2>&1 & echo $! > ".$1.pid"); }
sketchpad() { [ -e .sketchpad.pid ] && kill "$(cat .sketchpad.pid)"; start sketchpad; }
player() { start player; }
viewer() { start viewer; }
game() { start game; }
# A picture in the left pane, where SHOW_AT and SHOW_SIZE put it.
show() { (display -borderwidth 0 -geometry "${SHOW_AT:-+0+0}" -resize "${SHOW_SIZE:-224x480}>" "$1" >/dev/null 2>&1 &); }
clear
